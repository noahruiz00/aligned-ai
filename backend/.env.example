# Claude credentials. Leave empty to run in deterministic demo mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Force demo mode even when a key is present (useful for offline rehearsals)
DEMO_MODE=false

# PostgreSQL. Leave empty to use a local SQLite file (aligned.db).
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/aligned
DATABASE_URL=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
