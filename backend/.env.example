# OpenRouter credentials (backend only). Leave empty to run in deterministic demo mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
# Force demo mode even when a key is present (useful for offline rehearsals)
DEMO_MODE=false

# PostgreSQL. Leave empty to use a local SQLite file (aligned.db).
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/aligned
DATABASE_URL=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# --- Private beta security ---
# development (default): lax cookies, generated signing secret. production: Secure cookies and the three values below are required.
APP_ENV=development
# Signing secret for staff sessions. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Staff passwords (never commit real values). admin can also do everything an advisor can.
ADMIN_PASSWORD=
ADVISOR_PASSWORD=
# Only for a rehearsal with stand-in AI on a production deployment. Real beta runs must leave this unset.
ALLOW_DEMO_IN_PRODUCTION=
